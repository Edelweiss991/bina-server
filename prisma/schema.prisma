// Skema database BINA Server (PostgreSQL — Neon di produksi).
//
// Catatan: kolom `questions` (Task) dan `answers` (Submission) memakai
// tipe Json (JSONB di PostgreSQL). Untuk smoke test lokal tersedia
// salinan skema SQLite di test/schema.sqlite.prisma dengan kolom yang
// sama disimpan sebagai String JSON — lihat test/SMOKE_TEST.md dan
// helper jsonIn/jsonOut di src/db.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String
  role         String // 'guru' | 'siswa' (divalidasi di lapisan route)
  createdAt    DateTime      @default(now())

  classesOwned ClassRoom[]   @relation("ClassTeacher")
  memberships  ClassMember[]
  submissions  Submission[]
  scoreSync    ScoreSync?

  liveSessionsTaught LiveSession[]       @relation("SessionTeacher")
  attendances        Attendance[]
  liveAnswers        LiveAnswer[]
  understandingVotes UnderstandingVote[]
  breakoutMemberships BreakoutMember[]
  chatMessages       ChatMessage[]
  reportsWritten     ParentReport[]      @relation("ReportTeacher")
  reportsReceived    ParentReport[]      @relation("ReportStudent")

  announcements      Announcement[]
  schedulesTaught    Schedule[]          @relation("ScheduleTeacher")
  chatAsTeacher      ChatConversation[]  @relation("ChatTeacher")
  chatAsStudent      ChatConversation[]  @relation("ChatStudent")
  directMessages     ConversationMessage[]
}

model ClassRoom {
  id        Int           @id @default(autoincrement())
  name      String
  code      String        @unique
  teacherId Int
  teacher   User          @relation("ClassTeacher", fields: [teacherId], references: [id])
  members   ClassMember[]
  tasks     Task[]
  sessions  LiveSession[]
  reports   ParentReport[]
  announcements Announcement[]
  schedules Schedule[]
  conversations ChatConversation[]
  createdAt DateTime      @default(now())
}

model ClassMember {
  id       Int       @id @default(autoincrement())
  classId  Int
  userId   Int
  class    ClassRoom @relation(fields: [classId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  joinedAt DateTime  @default(now())

  @@unique([classId, userId])
}

model Task {
  id          Int          @id @default(autoincrement())
  classId     Int
  teacherId   Int
  title       String
  description String?
  // [{ "question": string, "options": [string x4], "correctIndex": 0..3 }]
  questions   Json
  class       ClassRoom    @relation(fields: [classId], references: [id])
  submissions Submission[]
  createdAt   DateTime     @default(now())
}

model Submission {
  id          Int      @id @default(autoincrement())
  taskId      Int
  studentId   Int
  // [int] indeks opsi yang dipilih per soal
  answers     Json
  autoScore   Int // skor otomatis 0..100 dari kunci jawaban
  score       Int? // nilai final dari guru (mengalahkan autoScore)
  review      String? // ulasan guru
  submittedAt DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id])
  student     User     @relation(fields: [studentId], references: [id])

  @@unique([taskId, studentId])
}

model ScoreSync {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  pretest       Int?
  posttest      Int?
  latihanBest   Int?
  simulatorBest Int?
  updatedAt     DateTime @updatedAt
}

// ─── Kelas Live (putaran BINA LIVE) ─────────────────────────────────────────

model LiveSession {
  id           Int      @id @default(autoincrement())
  classId      Int
  teacherId    Int
  title        String
  openingText  String?
  materialText String?
  status       String   @default("active") // 'active' | 'ended'
  startedAt    DateTime @default(now())
  endedAt      DateTime?

  class       ClassRoom         @relation(fields: [classId], references: [id])
  teacher     User              @relation("SessionTeacher", fields: [teacherId], references: [id])
  attendances Attendance[]
  quizzes     LiveQuiz[]
  votes       UnderstandingVote[]
  groups      BreakoutGroup[]
}

model Attendance {
  id        Int         @id @default(autoincrement())
  sessionId Int
  userId    Int
  joinedAt  DateTime    @default(now())
  session   LiveSession @relation(fields: [sessionId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model LiveQuiz {
  id           Int         @id @default(autoincrement())
  sessionId    Int
  title        String
  // [{ "question": string, "options": [string x4], "correctIndex": 0..3 }]
  questions    Json
  status       String      @default("waiting") // 'waiting' | 'running' | 'finished'
  currentIndex Int         @default(-1)
  bossMaxHp    Int
  createdAt    DateTime    @default(now())
  session      LiveSession @relation(fields: [sessionId], references: [id])
  answers      LiveAnswer[]
}

model LiveAnswer {
  id            Int      @id @default(autoincrement())
  quizId        Int
  userId        Int
  questionIndex Int
  selectedIndex Int
  correct       Boolean
  answeredAt    DateTime @default(now())
  quiz          LiveQuiz @relation(fields: [quizId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@unique([quizId, userId, questionIndex])
}

model UnderstandingVote {
  id        Int         @id @default(autoincrement())
  sessionId Int
  userId    Int
  level     Int // 0 = merah (belum paham), 1 = kuning, 2 = hijau (paham)
  updatedAt DateTime    @updatedAt
  session   LiveSession @relation(fields: [sessionId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
}

model BreakoutGroup {
  id        Int              @id @default(autoincrement())
  sessionId Int
  name      String
  session   LiveSession      @relation(fields: [sessionId], references: [id])
  members   BreakoutMember[]
  messages  ChatMessage[]
}

model BreakoutMember {
  id      Int           @id @default(autoincrement())
  groupId Int
  userId  Int
  group   BreakoutGroup @relation(fields: [groupId], references: [id])
  user    User          @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

model ChatMessage {
  id        Int           @id @default(autoincrement())
  groupId   Int
  userId    Int
  text      String
  createdAt DateTime      @default(now())
  group     BreakoutGroup @relation(fields: [groupId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
}

model ParentReport {
  id        Int       @id @default(autoincrement())
  classId   Int
  studentId Int
  teacherId Int
  content   String
  createdAt DateTime  @default(now())
  class     ClassRoom @relation(fields: [classId], references: [id])
  student   User      @relation("ReportStudent", fields: [studentId], references: [id])
  teacher   User      @relation("ReportTeacher", fields: [teacherId], references: [id])
}

// ─── Putaran BINA GURU: pengumuman, jadwal, chat guru↔siswa ──────────────────

model Announcement {
  id        Int       @id @default(autoincrement())
  classId   Int
  authorId  Int
  text      String
  createdAt DateTime  @default(now())
  class     ClassRoom @relation(fields: [classId], references: [id])
  author    User      @relation(fields: [authorId], references: [id])
}

// Satu jadwal mengajar untuk satu tanggal (date disimpan sebagai
// tengah malam UTC dari tanggal kalender yang dipilih guru).
model Schedule {
  id        Int           @id @default(autoincrement())
  classId   Int
  teacherId Int
  title     String
  date      DateTime
  createdAt DateTime      @default(now())
  class     ClassRoom     @relation(fields: [classId], references: [id])
  teacher   User          @relation("ScheduleTeacher", fields: [teacherId], references: [id])
  parts     SchedulePart[]
}

// Bagian/pertemuan di dalam satu jadwal (urut via sortOrder).
model SchedulePart {
  id         Int      @id @default(autoincrement())
  scheduleId Int
  title      String
  sortOrder  Int      @default(0)
  meetLink   String?
  createdAt  DateTime @default(now())
  schedule   Schedule @relation(fields: [scheduleId], references: [id])
}

// Percakapan chat persisten guru↔siswa: satu percakapan per
// (kelas, siswa). Status baca per pihak disimpan sebagai timestamp
// terakhir membaca (guruReadAt / siswaReadAt); pesan pihak lawan
// dengan createdAt lebih baru dari itu = belum dibaca.
//
// Catatan penamaan: model pesan breakout room yang sudah ada bernama
// ChatMessage, jadi pesan chat langsung ini bernama ConversationMessage.
model ChatConversation {
  id          Int      @id @default(autoincrement())
  classId     Int
  teacherId   Int
  studentId   Int
  createdAt   DateTime @default(now())
  guruReadAt  DateTime?
  siswaReadAt DateTime?

  class    ClassRoom           @relation(fields: [classId], references: [id])
  teacher  User                  @relation("ChatTeacher", fields: [teacherId], references: [id])
  student  User                  @relation("ChatStudent", fields: [studentId], references: [id])
  messages ConversationMessage[]

  @@unique([classId, studentId])
}

model ConversationMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  senderId       Int
  text           String
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  sender         User             @relation(fields: [senderId], references: [id])
}
